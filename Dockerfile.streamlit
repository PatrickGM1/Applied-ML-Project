FROM python:3.11-slim

WORKDIR /app

# Install only what Streamlit needs
RUN pip install --no-cache-dir streamlit requests

COPY streamlit_app.py .
COPY pages/ pages/

EXPOSE 8502

CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8502", "--server.address=0.0.0.0", "--server.headless=true"]
